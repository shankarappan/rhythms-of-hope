# Create a new Personal Access Token in GoDaddy with only the scopes needed.
# Never commit the real value. The local .env.local file is ignored by Git.
GODADDY_PAT=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMPLIMENTARY_COUPON_ID=
COMPLIMENTARY_CODE_HASH=
RESEND_API_KEY=
STATUS_PASSWORD=
SESSION_SIGNING_SECRET=
TICKETING_ENABLED=false
